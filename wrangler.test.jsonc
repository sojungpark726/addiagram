{
  // 테스트 빌드: 챗봇이 붙은 /test 페이지 + 관리자 + API (정식 addiagram Worker와 별개)
  // 배포: wrangler deploy -c wrangler.test.jsonc
  "name": "addiagram-test",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "build": {
    "command": "node scripts/build-site.mjs --test"
  },
  "assets": {
    "directory": "./public-test/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "CHAT_KV", "id": "d6b5d0320f92475aa2f194afcd121f58" }
  ],
  // 대화 하나의 상태(기록 · 횟수 · 경고 · 입력 중 감정)는 Durable Object에 저장 (늘 최신 값)
  "durable_objects": {
    "bindings": [{ "name": "CHAT_SESSION", "class_name": "ChatSession" }]
  },
  "exports": {
    "ChatSession": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "OPENAI_MODEL": "gpt-5.6-terra",
    // 테스트 Worker는 첫 화면이 없어서 /로 오면 /test/로 보냄
    "ROOT_REDIRECT": "/test/"
  }
  // 비밀값(OPENAI_API_KEY · ADMIN_PASSWORD · NOTIFY_TOKEN · typesafe_ai_api_key)은 .env에 적고
  // wrangler deploy -c wrangler.test.jsonc --secrets-file .env 로 올립니다.
}
