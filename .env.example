# 테스트 빌드(/test) 챗봇 비밀값. 이 파일을 .env로 복사해 값을 채우세요. (.env는 git에 올라가지 않습니다)
# 로컬 실행(wrangler dev -c wrangler.test.jsonc)은 .env를 읽고,
# 배포는 wrangler deploy -c wrangler.test.jsonc --secrets-file .env 로 Cloudflare에 올립니다.

# OpenAI API 키 (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# 관리자 페이지(/test/admin/) 비밀번호. 12자 이상 권장
ADMIN_PASSWORD=

# 대화 시작 알림 목록을 꺼내 갈 때 쓰는 토큰 (Claude 예약 작업이 Gmail 커넥터로 보낼 때 사용)
NOTIFY_TOKEN=
